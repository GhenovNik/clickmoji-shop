# Database
DATABASE_URL="postgresql://user:password@localhost:5432/clickmoji_shop?schema=public"

# Public canonical URL used by metadata, robots.txt, and sitemap.xml
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Auth.js / NextAuth
AUTH_URL="http://localhost:3000"
AUTH_SECRET="your-secret-key-here"
# Optional: true = always require email verification, false = never require it.
# If unset, verification is required only when RESEND is configured.
AUTH_REQUIRE_EMAIL_VERIFICATION=""
# Backward-compatible aliases (optional)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-here"

# Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Resend (email verification)
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""

# Distributed rate limit for auth (recommended for Vercel multi-instance)
# https://console.upstash.com/
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# UploadThing (for administrator-managed custom product/category images)
# Get your keys from https://uploadthing.com/dashboard
UPLOADTHING_TOKEN=""

# AI Image Generation (optional)
# Choose provider: "gemini" or "gpt-image". Everything else falls back to the gemini branch.
AI_PROVIDER="gemini"

# Google GenAI key, Gemini Developer API (https://aistudio.google.com/app/apikey)
GOOGLE_GENAI_API_KEY=""

# Google image model (optional). Unset, empty or whitespace = the default below.
# Default: gemini-3.1-flash-lite-image via models.generateContent, square 1:1, white background.
# The value is trimmed and must match the id grammar, otherwise generation fails with a
# configuration error naming GOOGLE_IMAGE_MODEL (no SDK call is made):
# - ^imagen-[a-z0-9]+(?:[.-][a-z0-9]+)*$            -> Imagen adapter (models.generateImages)
# - ^gemini-[a-z0-9]+(?:[.-][a-z0-9]+)*-image(...)?$ -> Gemini adapter (models.generateContent)
# The grammar only routes the id; it does not guarantee that the model can generate images.
# Known limitation: no transparent background, background removal would be a separate feature.
# Model EOL: the imagen-4.0-* family was retired by Google on 2026-08-17, so it is no longer a
# working choice. gemini-3.1-flash-lite-image has no announced shutdown date.
# GOOGLE_IMAGE_MODEL="gemini-3.1-flash-image"

# Deprecated synonym of GOOGLE_IMAGE_MODEL, still read when GOOGLE_IMAGE_MODEL is unset, empty or
# whitespace. Prefer GOOGLE_IMAGE_MODEL. Do not set it to imagen-4.0-* (retired 2026-08-17).
# IMAGEN_MODEL=""

# OpenAI key (https://platform.openai.com/api-keys)
OPENAI_API_KEY=""

# OpenAI image model (optional). Unset, empty or whitespace = the default below.
# Default: gpt-image-2.5-flare via images.generate with size 1024x1024, quality medium and
# background transparent; the prompt variant asks for a fully transparent background.
# The value is trimmed and must match ^gpt-image-[a-z0-9]+(?:[.-][a-z0-9]+)*$, otherwise
# generation fails with a configuration error naming OPENAI_IMAGE_MODEL (no SDK call is made).
# Model EOL: gpt-image-1.5 is retired by OpenAI on 2026-12-01; gpt-image-2.5-flare has no
# announced shutdown date.
# OPENAI_IMAGE_MODEL="gpt-image-1.5"
