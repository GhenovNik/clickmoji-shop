generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Пользователь
model User {
  id                   String    @id @default(cuid())
  email                String    @unique
  name                 String?
  password             String?
  image                String?
  role                 UserRole  @default(USER)
  emailVerified        DateTime?
  createdProductsCount Int       @default(0)

  lists            List[]
  favorites        Favorite[]
  variantFavorites VariantFavorite[]
  histories        ListHistory[]
  createdProducts  Product[]         @relation("UserCreatedProducts")
  aiUsage          AiUsageCounter[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
  @@map("password_reset_tokens")
}

// Paid AI calls per user and UTC day, shared by every server instance (src/lib/ai-quota.ts).
model AiUsageCounter {
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  windowStart DateTime
  count       Int      @default(0)
  updatedAt   DateTime @default(now())

  @@id([userId, windowStart])
  @@map("ai_usage_counters")
}

enum UserRole {
  USER
  ADMIN
}

// Категория продуктов
model Category {
  id       String  @id @default(cuid())
  name     String  @unique
  nameEn   String // английское название для поиска
  emoji    String // unicode emoji или URL кастомной картинки
  isCustom Boolean @default(false)
  imageUrl String? // для кастомных emoji
  order    Int     @unique

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("categories")
}

// Продукт (товар)
model Product {
  id         String  @id @default(cuid())
  name       String
  nameEn     String // английское название для поиска
  emoji      String // unicode emoji или URL кастомной картинки
  isCustom   Boolean @default(false)
  imageUrl   String? // для кастомных emoji
  // English variant of a picture with text on it; the app shows it when the UI is English.
  imageUrlEn String?

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  isGlobal    Boolean @default(true)
  createdById String?
  createdBy   User?   @relation("UserCreatedProducts", fields: [createdById], references: [id], onDelete: SetNull)

  variants     ProductVariant[]
  items        Item[]
  favorites    Favorite[]
  historyItems ListHistoryItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@index([name])
  @@map("products")
}

// Normalized emoji picture kept on its own, with or without a product: batch imports, AI
// generations and admin uploads land here, and a product or category uses one by its URL.
// A stored file listed here is never deleted by product, category or cleanup code.
model EmojiLibraryItem {
  id        String   @id @default(cuid())
  name      String
  nameEn    String?
  tags      String[] @default([])
  imageUrl  String   @unique
  // generated | upload | batch
  source    String
  // Stable origin, e.g. "batch-007#3"; re-importing the same cell updates instead of duplicating.
  sourceRef String?  @unique
  // null: no text, fits every language; "ru" / "en": text on the packaging in that language.
  locale    String?
  // Language variants of one picture share a key, e.g. "batch-007#3".
  groupKey  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@index([groupKey])
  @@map("emoji_library_items")
}

// Разновидность продукта (например: белый хлеб, багет)
model ProductVariant {
  id         String  @id @default(cuid())
  name       String
  nameEn     String
  emoji      String
  // A variant may have its own picture (Honeycrisp apple); English twin like Product.imageUrlEn.
  imageUrl   String?
  imageUrlEn String?

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  items        Item[]
  favorites    VariantFavorite[]
  historyItems ListHistoryItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
  @@map("product_variants")
}

// Список покупок
model List {
  id       String  @id @default(cuid())
  name     String
  isActive Boolean @default(false)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  items     Item[]
  histories ListHistory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([userId, isActive])
  @@map("lists")
}

model ListHistory {
  id          String   @id @default(cuid())
  listName    String
  completedAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  listId String?
  list   List?   @relation(fields: [listId], references: [id], onDelete: SetNull)

  items ListHistoryItem[]

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([listId])
  @@map("list_histories")
}

model ListHistoryItem {
  id        String      @id @default(cuid())
  historyId String
  history   ListHistory @relation(fields: [historyId], references: [id], onDelete: Cascade)

  // Snapshot fields below survive deletion; optional live references may not dangle.
  productId String?
  product   Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  productName       String
  // English copies taken at the same time, for the English UI; null falls back to Russian.
  productNameEn     String?
  productEmoji      String
  productImageUrl   String?
  productImageUrlEn String?
  categoryName      String
  categoryNameEn    String?
  isCustom          Boolean @default(false)

  variantName   String?
  variantNameEn String?
  variantEmoji  String?

  note        String?
  isPurchased Boolean  @default(false)
  addedAt     DateTime
  createdAt   DateTime @default(now())

  @@index([historyId])
  @@index([productId])
  @@index([variantId])
  @@map("list_history_items")
}

// Элемент списка (товар в списке)
model Item {
  id          String  @id @default(cuid())
  isPurchased Boolean @default(false)
  note        String? // заметка к товару (например, количество или комментарий)

  listId String
  list   List   @relation(fields: [listId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  purchasedAt DateTime?

  // Разрешаем дубликаты одного товара с разными заметками
  // Например: Брюква (2кг), Брюква (маленькая), Брюква (для супа)
  @@index([listId])
  @@index([productId])
  @@map("items")
}

// Избранные товары
model Favorite {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  usageCount Int @default(0) // сколько раз добавлялся в список

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, productId])
  @@index([userId])
  @@map("favorites")
}

// A variant the user starred: it shows as a card of its own among the favorites.
model VariantFavorite {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  usageCount Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, variantId])
  @@index([userId])
  @@map("variant_favorites")
}
