# Database
DATABASE_URL="postgresql://user:password@localhost:5432/clickmoji_shop?schema=public"

# Public canonical URL used by metadata, robots.txt, and sitemap.xml
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Auth.js / NextAuth
AUTH_URL="http://localhost:3000"
AUTH_SECRET="your-secret-key-here"
# Optional: true = always require email verification, false = never require it.
# If unset, verification is required only when RESEND is configured.
AUTH_REQUIRE_EMAIL_VERIFICATION=""
# Backward-compatible aliases (optional)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-here"

# Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Resend (email verification)
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""

# Distributed rate limit for auth (recommended for Vercel multi-instance)
# https://console.upstash.com/
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# UploadThing (for administrator-managed custom product/category images)
# Get your keys from https://uploadthing.com/dashboard
UPLOADTHING_TOKEN=""

# AI Image Generation (optional)
# Choose provider: "gemini" or "gpt-image"
AI_PROVIDER="gemini"

# Gemini Imagen (https://aistudio.google.com/app/apikey)
GOOGLE_GENAI_API_KEY=""

# Imagen model options:
# - imagen-4.0-generate-001 (default, higher quality, higher quota usage)
# - imagen-4.0-fast-generate-001 (faster, cheaper, lower quota usage)
IMAGEN_MODEL="imagen-4.0-fast-generate-001"

# Optional opt-in override for the Google image model (unset, empty or whitespace = legacy path).
# The value is trimmed and must match the id grammar, otherwise generation fails with a
# configuration error naming GOOGLE_IMAGE_MODEL (no SDK call is made):
# - ^imagen-[a-z0-9]+(?:[.-][a-z0-9]+)*$            -> Imagen adapter (models.generateImages)
# - ^gemini-[a-z0-9]+(?:[.-][a-z0-9]+)*-image(...)?$ -> Gemini adapter (models.generateContent)
# The grammar only routes the id; it does not guarantee that the model can generate images.
# Model EOL: the imagen-4.0-* family was retired by Google on 2026-08-17.
# GOOGLE_IMAGE_MODEL="gemini-3.1-flash-image"

# OpenAI GPT Image (https://platform.openai.com/api-keys)
OPENAI_API_KEY=""

# Optional opt-in override for the OpenAI image model (unset, empty or whitespace = gpt-image-1.5).
# The selected model must support images.generate({ model, prompt }) and return base64 PNG data.
# Model EOL: gpt-image-1.5 is retired by OpenAI on 2026-12-01.
# OPENAI_IMAGE_MODEL="gpt-image-2"
